# Make browsers re-check static files each visit (cheap 304 when unchanged),
# so a deploy never leaves visitors on an old design.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
